{
  "vhosts": [{ "name": "/" }],
  "users": [
    { "name": "${RABBIT_ADMIN_USER}",       "password": "${RABBIT_ADMIN_PASSWORD}",    "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": "administrator" },
    { "name": "${RABBIT_PRODUCER_USER}",    "password": "${RABBIT_PRODUCER_PASSWORD}", "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": "" },
    { "name": "${RABBIT_CONSUMER_USER}",    "password": "${RABBIT_CONSUMER_PASSWORD}", "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": "" }
  ],
  "permissions": [
    { "user": "${RABBIT_ADMIN_USER}",    "vhost": "/", "configure": ".*", "write": ".*", "read": ".*" },
    {
      "user": "${RABBIT_PRODUCER_USER}",
      "vhost": "/",
      "configure": ".*",      
      "write": ".*",          
      "read": "^(?!.*)$"      
    },
    {
      "user": "${RABBIT_CONSUMER_USER}",
      "vhost": "/",
      "configure": ".*",      
      "write": "^(?!.*)$",    
      "read": ".*"            
    }
  ],
  "policies": [],
  "exchanges": [
    {
    "name": "app_logs_exchange",           
    "type": "x-consistent-hash",        
    "durable": true,
    "vhost": "/",
    "auto_delete": false,
    "internal": false
    },
    {
      "name": "worker_tasks_exchange",
      "type": "direct",
      "durable": true,
      "vhost": "/",
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "logs_pipeline_1",
      "vhost": "/",
      "durable": true,
      "arguments": { "x-queue-type": "quorum" }
    },
    {
      "name": "logs_pipeline_2",
      "vhost": "/",
      "durable": true,
      "arguments": { "x-queue-type": "quorum" }
    },
    {
      "name": "logs_pipeline_3",
      "vhost": "/",
      "durable": true,
      "arguments": { "x-queue-type": "quorum" }
    },
    {
      "name": "worker_tasks_queue",
      "vhost": "/",
      "durable": true,
      "arguments": { "x-queue-type": "quorum" }
    }
  ],
  "bindings": [
    {
      "source": "app_logs_exchange",
      "vhost": "/",
      "destination": "logs_pipeline_1",
      "destination_type": "queue",
      "routing_key": "1"
    },
    {
      "source": "app_logs_exchange",
      "vhost": "/",
      "destination": "logs_pipeline_2",
      "destination_type": "queue",
      "routing_key": "1"
    },
    {
      "source": "app_logs_exchange",
      "vhost": "/",
      "destination": "logs_pipeline_3",
      "destination_type": "queue",
      "routing_key": "1"
    },
    {
      "source": "worker_tasks_exchange",
      "vhost": "/",
      "destination": "worker_tasks_queue",
      "destination_type": "queue",
      "routing_key": "tasks"
    }
  ]
}
